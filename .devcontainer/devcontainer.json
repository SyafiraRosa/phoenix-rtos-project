{
  "name": "Phoenix-RTOS Build Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "git submodule update --init --recursive && echo '✅ Submodules ready! Run: TARGET=ia32-generic-qemu source phoenix-rtos-build/build.sh all'",
  "containerEnv": {
    "TARGET": "ia32-generic-qemu"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "ms-vscode.hexeditor"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "C_Cpp.default.cStandard": "c11",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x86",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [],
  "mounts": []
}
